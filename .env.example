# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql://stocklens:stocklens@localhost:5433/stocklens

# M1 (prices pipeline) - see pipeline/README.md for how to get these:
# BREEZE_API_KEY=
# BREEZE_API_SECRET=
# BREEZE_API_SESSION=   # expires periodically, regenerate via pipeline/README.md

# Deploy only - backend/routers/breeze_auth.py's session-capture callback.
# Generate once: openssl rand -hex 16
# BREEZE_CALLBACK_TOKEN=
# Path to this .env file, relative to the backend process's cwd (default: ../.env,
# i.e. backend/ as cwd, repo root one level up - matches the deployed systemd unit).
# ENV_FILE_PATH=
