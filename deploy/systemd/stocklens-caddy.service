[Unit]
Description=StockLens web server (Caddy)
After=network-online.target

[Service]
Environment=STOCKLENS_ROOT=%h/projects/trading
ExecStart=/usr/bin/caddy run --config %h/projects/trading/deploy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config %h/projects/trading/deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
